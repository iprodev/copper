# copy to .env (install.sh does it for you) and edit. keep this file private.

# domains, both must point to this server (dns A/AAAA records)
WEB_DOMAIN=fetchr.download
API_DOMAIN=api.fetchr.download

# local port of the api, only reachable from this server (nginx uses it)
API_PORT=9000

# image version: 1 = latest 1.x release
FETCHR_VERSION=1

# services that go through cloudflare warp (see docs/api-env-variables.md#service_proxies)
SERVICE_PROXIES=youtube=socks5://warp:1080

# warp+ license key (optional)
WARP_LICENSE_KEY=

# limits (per ip per minute) and the longest allowed media, in seconds
RATELIMIT_MAX=20
TUNNEL_RATELIMIT_MAX=120
DURATION_LIMIT=10800
DISABLED_SERVICES=newgrounds

# ---- telegram bot ----
# turn the bot on with: COMPOSE_PROFILES=bot
COMPOSE_PROFILES=
BOT_TOKEN=
# api key of the bot, made by install.sh (it's also in keys.json)
BOT_API_KEY=
BOT_VIDEO_QUALITY=720
# telegram user ids of the bot's admins (comma-separated), they get /admin
BOT_ADMIN_IDS=
BOT_MAX_FILE_SIZE_MB=

# local bot api server (files up to 2000 MB). needs api id & hash from
# https://my.telegram.org, then: COMPOSE_PROFILES=bot,bot-api-server
# and TELEGRAM_API_URL=http://telegram-bot-api:8081
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_API_URL=

# the database of the bot is sent to the admins every day at this hour
# (server time), -1 turns it off
BOT_BACKUP_HOUR=4

# ---- monitoring (monitor.sh, every 10 minutes) ----
# alerts go to BOT_ADMIN_IDS through the bot. language of alerts: fa or en
MONITOR_LANGUAGE=fa
# the youtube video used to check that downloads work
MONITOR_YOUTUBE_URL=
